<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="local,windows,powershell,">

  <rule id="100010" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-e |-enc |-EncodedCommand)</field>
    <description>Suspicious PowerShell execution with encoded command (T1059.001)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

</group>
<group name="local,windows,credential_access,">

  <rule id="100011" level="15">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(mimikatz|sekurlsa|lsadump|privilege::debug|invoke-mimikatz)</field>
    <description>Possible Mimikatz execution detected - Credential Dumping (T1003)</description>
    <mitre>
      <id>T1003</id>
    </mitre>
  </rule>

  <rule id="100012" level="15">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)(lsass\.exe)</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)(powershell|cmd|mimikatz)</field>
    <description>Suspicious process accessing LSASS - possible credential dumping (T1003.001)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

</group>

<group name="local,linux,discovery,">
  <rule id="100014" level="10">
    <if_group>audit</if_group>
    <field name="audit.command">cat</field>
    <field name="audit.execve.a1">/etc/passwd</field>
    <description>Sensitive file accessed via cat - possible Account Discovery (T1087)</description>
    <mitre>
      <id>T1087</id>
    </mitre>
  </rule>
</group>

